rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('role', '') == 'admin';
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    function hasVerifiedEmail() {
      return request.auth.token.email_verified == true;
    }

    function isUnderMb(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    function isProfilePhoto() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|quicktime|webm)');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantIds;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(userId) && isProfilePhoto() && isUnderMb(5);
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    match /requestMedia/{userId}/{draftId}/{fileName} {
      allow read: if isOwnerOrAdmin(userId);
      allow create: if isOwner(userId) && ((isImage() && isUnderMb(10)) || (isVideo() && isUnderMb(100)));
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    match /technicianDocuments/{userId}/{fileName} {
      allow read: if isOwnerOrAdmin(userId);
      allow create: if isOwner(userId) && hasVerifiedEmail() && (isImage() || isPdf()) && isUnderMb(10);
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    match /conversations/{conversationId}/{fileName} {
      allow read: if isConversationParticipant(conversationId) || isAdmin();
      allow create: if isConversationParticipant(conversationId) && isImage() && isUnderMb(10);
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
