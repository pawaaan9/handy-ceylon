# Handy Ceylon — environment variables
# Copy to .env.local and fill in values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Firebase web app config (public — shipped to the browser)
# Firebase console → Project settings → General → Your apps → Web app → Config
# These identify the project; security comes from Security Rules and server checks.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the browser SDK at the local Firebase Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ---------------------------------------------------------------------------
# Firebase Admin SDK (SERVER ONLY — never prefix with NEXT_PUBLIC_)
# Firebase console → Project settings → Service accounts → Generate new private key
# Leave blank to use Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS,
# Firebase App Hosting, Cloud Run).
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the key on one line with literal \n sequences, wrapped in double quotes.
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional: defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
FIREBASE_STORAGE_BUCKET=

# When using emulators, the Admin SDK reads these automatically:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
