rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.get('role', '') == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTechnician() {
      return hasRole('technician');
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    function incoming() {
      return request.resource.data;
    }

    function changesOnly(fields) {
      return incoming().diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function stampedNow() {
      return incoming().updatedAt == request.time;
    }

    function requestOf(requestId) {
      return get(/databases/$(database)/documents/serviceRequests/$(requestId)).data;
    }

    function isRequestCustomer(requestId) {
      return isSignedIn() && requestOf(requestId).customerId == request.auth.uid;
    }

    function isAssignedTechnician(requestId) {
      return isSignedIn() && requestOf(requestId).selectedTechnicianId == request.auth.uid;
    }

    function isBookingParticipant(bookingId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/bookings/$(bookingId)).data.participantIds;
    }

    function isListedParticipant() {
      return isSignedIn() && request.auth.uid in resource.data.participantIds;
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    function isValidTechnicianEdit() {
      return changesOnly(['bio', 'categoryIds', 'serviceDistricts', 'availability', 'updatedAt'])
        && incoming().bio is string
        && incoming().bio.size() <= 1000
        && incoming().categoryIds is list
        && incoming().categoryIds.size() <= 10
        && incoming().serviceDistricts is list
        && incoming().serviceDistricts.size() <= 25
        && incoming().availability in ['online', 'offline']
        && stampedNow();
    }

    function isValidMessage(conversationId) {
      return incoming().keys().hasOnly(['senderId', 'body', 'attachmentPath', 'createdAt'])
        && incoming().senderId == request.auth.uid
        && incoming().body is string
        && incoming().body.size() > 0
        && incoming().body.size() <= 2000
        && (incoming().attachmentPath == null
          || incoming().attachmentPath.matches('conversations/' + conversationId + '/.+'))
        && incoming().createdAt == request.time;
    }

    match /customers/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      allow write: if false;

      match /addresses/{addressId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }
    }

    match /technicians/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      allow update: if isOwner(userId) && isTechnician() && isValidTechnicianEdit();
      allow create, delete: if false;
    }

    match /admins/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      allow write: if false;
    }

    match /technicianApplications/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      allow write: if false;
    }

    match /phoneIndex/{phoneNumber} {
      allow read, write: if false;
    }

    match /notifications/{userId}/items/{notificationId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) && changesOnly(['read']) && incoming().read is bool;
      allow create, delete: if false;
    }

    match /serviceCategories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;
    }

    match /services/{serviceId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;
    }

    // Written only by the server (customers create and cancel through Server
    // Actions), so no client can set a status or assign a technician.
    match /serviceRequests/{requestId} {
      allow read: if isAdmin()
        || isOwner(resource.data.customerId)
        || isOwner(resource.data.selectedTechnicianId)
        || (isTechnician() && resource.data.status == 'open');
      allow write: if false;

      match /private/{docId} {
        allow read: if isAdmin() || isRequestCustomer(requestId) || isAssignedTechnician(requestId);
        allow write: if false;
      }

      match /history/{eventId} {
        allow read: if isAdmin() || isRequestCustomer(requestId) || isAssignedTechnician(requestId);
        allow write: if false;
      }

      match /offers/{technicianId} {
        allow read: if isAdmin() || isOwner(technicianId) || isRequestCustomer(requestId);
        allow write: if false;
      }
    }

    match /quotations/{quotationId} {
      allow read: if isAdmin()
        || isOwner(resource.data.customerId)
        || isOwner(resource.data.technicianId);
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin() || isListedParticipant();
      allow write: if false;

      match /statusHistory/{eventId} {
        allow read: if isAdmin() || isBookingParticipant(bookingId);
        allow write: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || isListedParticipant();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAdmin() || isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId) && isValidMessage(conversationId);
        allow update, delete: if false;
      }
    }

    match /reviews/{bookingId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
